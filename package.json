{
  "name": "@codemonger-io/maplibre-geo-circle-layer",
  "version": "0.1.0",
  "description": "MapLibre layer that renders a circle",
  "packageManager": "pnpm@10.12.1",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.js.map",
    "dist/index.mjs.map",
    "dist/index.d.ts",
    "README_ja.md"
  ],
  "scripts": {
    "build": "rollup -c && api-extractor run --local",
    "build:doc": "run-s build && api-documenter markdown --input-folder temp --output-folder api-docs/markdown",
    "type-check": "tsc --noEmit",
    "prepare": "run-s build",
    "test": "jest"
  },
  "keywords": [
    "maplibre"
  ],
  "author": "Kikuo Emoto <kemoto@codemonger.io>",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@microsoft/api-documenter": "^7.26.31",
    "@microsoft/api-extractor": "^7.52.10",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "maplibre-gl": "catalog:",
    "npm-run-all2": "catalog:",
    "rollup": "^4.46.3",
    "ts-jest": "^29.4.1",
    "tslib": "^2.8.1",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5 <6"
  }
}
